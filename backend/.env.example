DEMO_MODE=true
# DB_URL defaults to backend/data/app.db (absolute path, works on Windows and Linux/macOS).
# DB_URL=sqlite:///C:/path/to/app.db
FLAG_THRESHOLD=0.40
QUARANTINE_THRESHOLD=0.70
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ethereum node running the AgriChainLedger contract (local Hardhat node: `npm run node` in blockchain/).
CHAIN_RPC_URL=http://127.0.0.1:8545
# Accounts that act on the contract. Defaults are Hardhat's public dev keys #0-#2 — fine for a local
# node, NEVER for a real network. Set your own (funded) keys to use e.g. Sepolia.
# ADMIN_PRIVATE_KEY=0x...
# ORACLE_PRIVATE_KEY=0x...
# AUDITOR_PRIVATE_KEY=0x...
